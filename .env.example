# Copy to .env only when configuring a new environment; keep existing local .env.
# Generate POSTGRES_PASSWORD securely. URL-encode the password inside DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://smartrobot:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/smartrobot

# Optional pool settings:
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=5000

# Authentication: generate a unique random value; never commit the real secret.
# Example generation (do not copy command output into source control):
# uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
ENVIRONMENT=development
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
JWT_ISSUER=smartrobot
JWT_AUDIENCE=smartrobot-web
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOGIN_IP_LIMIT=30
LOGIN_IDENTITY_LIMIT=10
LOGIN_WINDOW_SECONDS=300
ROBOT_OFFLINE_AFTER_SECONDS=15

# Control leases and bounded command validity (milliseconds for command TTLs).
CONTROL_LEASE_SECONDS=10
MANUAL_COMMAND_TTL_MS=700
MODE_COMMAND_TTL_MS=3000
COMMAND_HISTORY_LIMIT=1000
COMMAND_RETENTION_DAYS=7
CONTROL_CLEANUP_INTERVAL_SECONDS=1
# Keep below the frontend's 4-second connection watchdog; accepted range 0.1–2.
WEBSOCKET_INTERVAL_SECONDS=1

# Real ESP32 Device API. HTTPS required by default; HTTP opt-in for private LAN only.
DEVICE_ALLOW_INSECURE_HTTP=false
DEVICE_HEARTBEAT_INTERVAL_MS=2000
DEVICE_POLL_INTERVAL_MS=100
DEVICE_TELEMETRY_MIN_INTERVAL_MS=200
TELEMETRY_RETENTION_DAYS=7
TELEMETRY_HISTORY_LIMIT=10000

# Production: ENVIRONMENT=production, COOKIE_SECURE=true, HTTPS CORS_ORIGINS.
# Serve the frontend and /api through the same HTTPS origin.
